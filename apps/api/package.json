{
  "name": "@aimag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scrape:once": "tsx src/scraper/cli.ts",
    "scrape": "tsx src/scraper/run-cli.ts",
    "backfill": "tsx src/scraper/run-cli.ts --since",
    "seed": "tsx src/db/seed-cli.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "create-admin": "tsx src/db/create-admin.ts"
  },
  "dependencies": {
    "@aimag/shared": "workspace:*",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "node-cron": "^4.6.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}

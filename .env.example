# Copy to .env and adjust. Never commit .env.
# This one file serves local development (pnpm dev) AND `docker compose` (production-style stack).
# Generate each secret with:  openssl rand -base64 48 | tr -d '\n=/+' | head -c 48
NODE_ENV=development
LOG_LEVEL=info

# Database (the response cache is in-memory; Redis is not used)
MONGODB_URI=mongodb://localhost:27017/aimag

# API
API_PORT=4000
# Public base URL of the API as browsers reach it (builds uploaded-image URLs). Default http://localhost:<API_PORT>;
# behind nginx on one domain, set it to the site URL.
#PUBLIC_API_URL=http://localhost:4000
# Reverse proxies in front of the API (default 1: nginx in production, the Next.js server in development)
#TRUST_PROXY_HOPS=1
# Sign-in attempts allowed per IP per 15 minutes
#LOGIN_RATE_LIMIT_MAX=10
CORS_ORIGINS=http://localhost:3100
JWT_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-too
WEB_URL=http://localhost:3100

# Web app (Next.js reads this same file). API_URL is server-side, NEXT_PUBLIC_* are visible to browsers.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_CONTACT_EMAIL=editor@example.com

# Scraper (source: aimagazine.com). Contact email is shown in the User-Agent.
SCRAPER_BASE_URL=https://aimagazine.com
SCRAPER_CONTACT_EMAIL=you@example.com
SCRAPER_DELAY_MS=1750
SCRAPER_MAX_RETRIES=3
# hotlink | placeholder
IMAGE_MODE=hotlink

# Scheduler (runs inside the API process)
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 */6 * * *
SCHEDULER_RETRIES=2
SCHEDULER_RETRY_DELAY_MS=60000
SCHEDULER_RUN_LIMIT=100
# Optional: Slack/Discord/generic webhook that receives failure alerts
ALERT_WEBHOOK_URL=

# Development: also publish MongoDB on localhost:27017 for `pnpm dev` and the tests.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# --- Docker Compose stack (docker compose up -d --build) ---
# Public URL of the site, no trailing slash. Baked into the web build: re-run `up --build` after changing it.
SITE_URL=http://localhost:8080
CONTACT_EMAIL=editor@example.com
HTTP_PORT=8080
# Bind address of the HTTP port. Use 127.0.0.1 if something else (a CDN or load balancer) fronts the stack.
HTTP_BIND=0.0.0.0
# HTTPS (docker-compose.tls.yml): set COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml,
# HTTP_PORT=80, HTTPS_PORT=443 and DOMAIN. See docs/DEPLOYMENT.md.
#DOMAIN=example.com
#HTTPS_PORT=443
# Set true to let Next resize/convert source images to WebP and cache them on our server (see README).
IMAGE_OPTIMIZE=false

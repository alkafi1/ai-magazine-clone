# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Database / cache
MONGODB_URI=mongodb://localhost:27017/aimag
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-too
WEB_URL=http://localhost:3000

# Scraper (source: aimagazine.com). Contact email is shown in the User-Agent.
SCRAPER_BASE_URL=https://aimagazine.com
SCRAPER_CONTACT_EMAIL=you@example.com
SCRAPER_DELAY_MS=1750
SCRAPER_MAX_RETRIES=3
# hotlink | placeholder
IMAGE_MODE=hotlink
